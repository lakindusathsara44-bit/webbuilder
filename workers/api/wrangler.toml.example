name = "apokolips-builder-api"
main = "src/index.js"
compatibility_date = "2026-11-08"
compatibility_flags = ["nodejs_compat"]

[vars]
SUPABASE_URL = "https://qccbsuxomdqdwfnqoycb.supabase.co"
DASHBOARD_ORIGIN = "https://builder.apokolips.xyz,http://localhost:5173"

[[d1_databases]]
binding = "DB"
database_name = "apokolips-builder-db"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "ASSETS"
bucket_name = "apokolips-builder-assets"

# Copy this example to wrangler.toml only after creating D1 and R2.
# Never commit Cloudflare account tokens or other secrets.
